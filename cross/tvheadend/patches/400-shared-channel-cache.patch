+ *  but WITHOUT ANY WARRANTY; without even the implied warranty of
+ *  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ *  GNU General Public License for more details.
+ *
+ *  You should have received a copy of the GNU General Public License
+ *  along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * With "Record from cache" each tuned channel already keeps its last
+ * "Maximum period" of MPEG-TS (timeshift_svcbuf.c).  A client pausing or
+ * rewinding live TV is served from that cache here, instead of writing a
+ * buffer of its own -- one cache per channel, however many clients.
+ *
+ * This target takes the place of timeshift_create() in the client's chain,
+ * after tsfix and the global headers, and answers the same speed / skip
+ * requests with the same messages.  Live, it passes packets through.  Out
+ * of live, it reads the channel cache through a private parser and hands
+ * the client packets in the client's own time base: the offset between
+ * source and client timestamps is calibrated by matching replayed video
+ * frames against the recent live ones (the sharer and tsfix both move the
+ * client's time base).  Back to live, packets the client already has are
+ * dropped by their DTS, so the join has neither a gap nor a duplicate.
+ */
+
+#include "tvheadend.h"
+#include "streaming.h"
+#include "service.h"
+#include "packet.h"
+#include "timeshift.h"
+#include "timeshift/private.h"
+#include "timeshift/timeshift_svcbuf.h"
+#include "timeshift/timeshift_svcts.h"
+#include "parsers/parsers.h"
+#include "plumbing/globalheaders.h"
+
+#define SVCTS_RING        512       ///< Recent live video packets, to calibrate
+#define SVCTS_PREROLL     2000000   ///< us parsed before a target (keyframe)
+#define SVCTS_CALIB_BACK  4000000   ///< us back from live to replay on entry
+#define SVCTS_REWIND_STEP 1000000   ///< us stepped back for a keyframe
+#define SVCTS_AUDIO_STEP  500000    ///< us between rewind points with no video
+#define SVCTS_EXPIRED_GAP 10000000  ///< us ahead of the oldest data after an
+                                    ///< expiry, as both then move at 1x
+#define SVCTS_NSTREAMS    256
+
+enum {
+  SVCTS_LIVE,
+  SVCTS_PAUSE,
+  SVCTS_PLAY
+};
+
+typedef struct svcts_key {
+  int64_t  dts;       ///< Client time base, 90 kHz
+  uint32_t crc;
+  uint32_t len;
+  uint8_t  index;
+  uint8_t  used;
+} svcts_key_t;
+
+typedef struct svcts_pkt {
+  TAILQ_ENTRY(svcts_pkt) link;
+  th_pkt_t          *pkt;       ///< Timestamps in the client time base
+  int64_t            time;      ///< us
+  streaming_start_t *start;     ///< Stream map valid for this packet
+  uint64_t           start_seq; ///< Cache stream-map generation
+} svcts_pkt_t;
+
+TAILQ_HEAD(svcts_pkt_queue, svcts_pkt);
+
+typedef struct svcts {
+  streaming_target_t   input;
+  streaming_target_t  *output;
+  tvh_mutex_t          lock;
+  tvh_cond_t           cond;
+  pthread_t            thread;
+  int                  run;
+
+  /* shared with the live side (lock) */
+  svcbuf_t            *sb;          ///< Buffer of the attached service
+  svcbuf_t            *sb_old;      ///< Detached, for the thread to release
+  int                  reset;       ///< The thread drops its replay
+  TAILQ_HEAD(, streaming_message) ctrl;
+  int                  state;
+  int                  speed;
+  int                  keyframe_mode;
+  int64_t              pause_time;  ///< us delivered at mono_play
+  int64_t              mono_play;
+  int64_t              last_time;   ///< us of the last packet out
+  int64_t              live_time;   ///< us of the newest live packet
+  int64_t              live_mono;
+  streaming_start_t   *live_start;  ///< Current live map after globalheaders
+  uint64_t             live_start_seq; ///< Cache generation of live_start
+  streaming_start_t   *out_start;   ///< Map last sent to the client
+  uint64_t             out_start_seq;
+  int                  live_rebase_pending;
+  int                  live_rebase_wait_video;
+  int64_t              live_rebase_deadline;
+  int64_t              live_last_dts;
+  int64_t              live_last_video_dts;
+  int64_t              live_pts_off;
+  int64_t              out_dts[SVCTS_NSTREAMS];
+  uint8_t              is_video[SVCTS_NSTREAMS];
+  svcts_key_t          ring[SVCTS_RING];
+  int                  ring_pos;
+  int                  calibrated;
+  int64_t              off;         ///< Source minus client, 90 kHz
+  struct svcts_pkt_queue q;          ///< Replayed, client time base
+  int64_t              expect;      ///< 90 kHz, to unwrap source times
+  int64_t              replay_last_dts;
+  int                  replay_rebase_pending;
+  int                  replay_rebase_exact;
+  int64_t              replay_anchor;
+
+  /* thread */
+  svcbuf_reader_t     *rd;
+  service_t           *rd_service;
+  streaming_target_t  *parser;
+  streaming_target_t  *headers;
+  streaming_start_t   *rd_start;    ///< Replay map after globalheaders
+  uint64_t             rd_start_seq;
+  uint64_t             read_start_seq;
+  uint64_t             replay_prev_seq;
+  streaming_target_t   sink;
+  int                  at_head;
+  int                  reanchor;    ///< Restart the pacing on the next one
+  int64_t              skip_to;     ///< us: drop until a keyframe from here
+  int                  skip_pending; ///< ... which is a position, not a flag:
+                                     ///< a seek to 0 is a seek like any other
+  int                  skip_back;   ///< ... or the last one before, going back
+  streaming_message_t *skip_reply;  ///< Answered with the first packet
+  int64_t              skip_seen;   ///< us: the newest packet dropped meanwhile
+  int64_t              skip_seen_kf; ///< ... and the newest keyframe, or 0
+  svcts_pkt_t         *rw_pkt;      ///< Rewind: next keyframe to show
+  int64_t              mono_status;
+} svcts_t;
+
+int
+svcts_enabled ( void )
+{
+  return timeshift_conf.enabled && timeshift_conf.record_cache &&
+         !(timeshift_conf.ram_only && timeshift_conf.ram_size == 0);
+}
+
+/* **************************************************************************
+ * Helpers (lock held)
+ * *************************************************************************/
+
+static inline int
+svcts_is_keyframe ( const th_pkt_t *pkt )
+{
+  return SCT_ISVIDEO(pkt->pkt_type) && pkt->v.pkt_frametype == PKT_I_FRAME;
+}
+
+static inline int64_t
+svcts_pkt_time ( const th_pkt_t *pkt )
+{
+  return ts_rescale(pkt->pkt_pts != PTS_UNSET ? pkt->pkt_pts : pkt->pkt_dts,
+                    1000000);
+}
+
+static int
+svcts_key ( th_pkt_t *pkt, svcts_key_t *k, int audio_too )
+{
+  size_t len = pktbuf_len(pkt->pkt_payload);
+  if (len < 64 || pkt->pkt_dts == PTS_UNSET)
+    return 0;
+  /*
+   * Video frames are the distinctive ones, and keeping audio out of the ring
+   * leaves every slot for them.  A service with no video has none to put
+   * there, though, and without a fingerprint it never calibrates: pause
+   * answers speed 100 and every seek answers SMT_SKIP_ERROR.  The key
+   * carries the component index, so an audio frame can only ever match
+   * another frame of the same component.
+   */
+  if (!SCT_ISVIDEO(pkt->pkt_type) &&
+      !(audio_too && SCT_ISAUDIO(pkt->pkt_type)))
+    return 0;
+  k->index = pkt->pkt_componentindex;
+  k->len   = len;
+  k->crc   = tvh_crc32(pktbuf_ptr(pkt->pkt_payload), MIN(len, 188), 0);
+  k->used  = 1;
+  return 1;
+}
+
+/* Bring a source time (33 bits) next to where the client time base is */
+static int64_t
+svcts_unwrap ( int64_t v, int64_t expect )
+{
+  const int64_t wrap = PTS_MASK + 1;
+  if (expect == PTS_UNSET)
+    return v;
+  while (v < expect - wrap / 2) v += wrap;
+  while (v > expect + wrap / 2) v -= wrap;
+  return v;
+}
+
+static void
+svcts_start_set ( streaming_start_t **dst, streaming_start_t *ss )
+{
+  if (*dst == ss)
+    return;
+  if (ss)
+    streaming_start_ref(ss);
+  if (*dst)
+    streaming_start_unref(*dst);
+  *dst = ss;
+}
+
+/* Match the layout test used by normal timeshift in #2206.  A source PID
+ * change alone needs a new START, but not a STOP which would flush queued
+ * output. */
+static int
+svcts_start_layout_differs ( const streaming_start_t *a,
+                             const streaming_start_t *b )
+{
+  int i;
+
+  if (a == b)
+    return 0;
+  if (a == NULL || b == NULL)
+    return 1;
+
+  if (a->ss_service_id != b->ss_service_id ||
+      a->ss_pmt_pid != b->ss_pmt_pid ||
+      a->ss_pcr_pid != b->ss_pcr_pid ||
+      a->ss_num_components != b->ss_num_components)
+    return 1;
+
+  for (i = 0; i < a->ss_num_components; i++)
+    if (a->ss_components[i].es_index != b->ss_components[i].es_index ||
+        a->ss_components[i].es_type != b->ss_components[i].es_type)
+      return 1;
+
+  return 0;
+}
+
+/* Same discontinuity rule as packet timeshift: normal 33-bit wraps remain
+ * unwrapped; a real clock reset is moved just beyond the previous packet. */
+static int64_t
+svcts_packet_rebase_target ( int64_t last_pts, int64_t adjusted_pts )
+{
+  int64_t delta;
+
+  if (adjusted_pts >= last_pts - 90000)
+    return adjusted_pts;
+
+  delta = pts_diff(last_pts, adjusted_pts);
+  if (delta >= 0 && delta <= 2 * 90000)
+    return last_pts + delta;
+
+  return last_pts + 1;
+}
+
+static void
+svcts_out_reset ( svcts_t *st )
+{
+  int i;
+  for (i = 0; i < SVCTS_NSTREAMS; i++)
+    st->out_dts[i] = PTS_UNSET;
+}
+
+static int
+svcts_start_has_video ( const streaming_start_t *ss )
+{
+  int i;
+
+  if (ss == NULL)
+    return 0;
+
+  for (i = 0; i < ss->ss_num_components; i++)
+    if (!ss->ss_components[i].ssc_disabled &&
+        !ss->ss_components[i].ssc_muxer_disabled &&
+        SCT_ISVIDEO(ss->ss_components[i].es_type))
+      return 1;
+
+  return 0;
+}
+
+/* Send the map which belongs to replayed packets.  PID-only changes get a
+ * START without a STOP; a real layout change gets SOURCE_RECONFIGURED.
+ * A seek response is deliberately sent by the caller before this helper. */
+static void
+svcts_output_start ( svcts_t *st, streaming_start_t *ss, uint64_t seq )
+{
+  int reconfigured;
+
+  if (ss == NULL)
+    return;
+
+  if (st->out_start == ss) {
+    st->out_start_seq = seq;
+    return;
+  }
+
+  reconfigured = st->out_start &&
+                 svcts_start_layout_differs(st->out_start, ss);
+
+  if (reconfigured) {
+    streaming_target_deliver2
+      (st->output,
+       streaming_msg_create_code(SMT_STOP, SM_CODE_SOURCE_RECONFIGURED));
+    svcts_out_reset(st);
+  }
+
+  streaming_start_ref(ss);
+  streaming_target_deliver2
+    (st->output, streaming_msg_create_data(SMT_START, ss));
+
+  svcts_start_set(&st->out_start, ss);
+  st->out_start_seq = seq;
+}
+
+static void
+svcts_pkt_drop ( svcts_pkt_t *p )
+{
+  if (p == NULL)
+    return;
+  if (p->start)
+    streaming_start_unref(p->start);
+  pkt_ref_dec(p->pkt);
+  free(p);
+}
+
+/* A packet the client does not have yet: remember its DTS */
+static int
+svcts_out_new ( svcts_t *st, const th_pkt_t *pkt )
+{
+  int64_t *last = &st->out_dts[pkt->pkt_componentindex];
+  if (pkt->pkt_dts == PTS_UNSET)
+    return 1;
+  if (*last != PTS_UNSET && pkt->pkt_dts <= *last)
+    return 0;
+  *last = pkt->pkt_dts;
+  return 1;
+}
+
+static void
+svcts_queue_clear ( svcts_t *st )
+{
+  svcts_pkt_t *p;
+
+  while ((p = TAILQ_FIRST(&st->q)) != NULL) {
+    TAILQ_REMOVE(&st->q, p, link);
+    svcts_pkt_drop(p);
+  }
+
+  if (st->rw_pkt) {
+    svcts_pkt_drop(st->rw_pkt);
+    st->rw_pkt = NULL;
+  }
+}
+
+/* Oldest time (us, client base) the client may go back to, 0 if none.
+ *
+ * Bounded by what the cache actually holds, not by the configured timeshift
+ * period.  Retention is svcbuf_expire()'s business, and it deliberately keeps
+ * blocks a reader still needs however old they are, so a cache feeding a
+ * recording reaches back to the programme's start whatever the period says.
+ * Applying the period again here would hide exactly the data that exception
+ * preserved, and the same bytes are served without complaint when the
+ * in-progress recording is played back instead.
+ *
+ * The cache can also reach further back than this subscription has existed,
+ * when another viewer tuned the channel first or the keepalive held it.  That
+ * part sits before the client's own zero, so offering it means answering with
+ * negative timestamps, which a player that cannot order them renders as a
+ * frozen picture with sound until playback reaches the moment the viewer tuned
+ * in.  Clamped away by default; offered when "Cache seek before tune-in" is
+ * set, for clients that do handle negative positions.
+ *
+ * Recording from the cache is not affected: the DVR replays it on a time base
+ * of its own, which is what lets a recording still start at the programme's
+ * start.
+ */
+/* Whether a seekable range exists at all, whatever its bounds.  Kept apart
+ * from svcts_oldest(), which answers 0 both for "no cache" and for a range
+ * clamped to the client's own zero -- two things that mean the opposite to a
+ * client, so the presence of a range cannot be read from its value. */
+static int
+svcts_span ( svcts_t *st, int64_t *oldest, int64_t *newest )
+{
+  return st->sb != NULL && st->live_time != 0 &&
+         svcbuf_span(st->sb, oldest, newest);
+}
+
+static int64_t
+svcts_oldest ( svcts_t *st )
+{
+  int64_t oldest;
+  int64_t newest;
+  int64_t t;
+  if (!svcts_span(st, &oldest, &newest))
+    return 0;
+  t = st->live_time - (st->live_mono - oldest) + SVCTS_PREROLL;
+  if (!timeshift_conf.cache_seek_tunein && t < 0)
+    t = 0;
+  return MIN(t, st->live_time);
+}
+
+static void
+svcts_fill_status ( svcts_t *st, timeshift_status_t *status )
+{
+  int64_t cur = st->state == SVCTS_LIVE ? st->live_time : st->last_time;
+  int64_t oldest;
+  int64_t newest;
+
+  status->full = 0;
+  status->shift = ts_rescale_inv(MAX(0, st->live_time - cur), 1000000);
+  if (svcts_span(st, &oldest, &newest)) {
+    status->pts_start = ts_rescale_inv(svcts_oldest(st), 1000000);
+    status->pts_end   = ts_rescale_inv(st->live_time, 1000000);
+  } else {
+    status->pts_start = PTS_UNSET;
+    status->pts_end   = PTS_UNSET;
+  }
+}
+
+static void
+svcts_status ( svcts_t *st )
+{
+  timeshift_status_t *status = calloc(1, sizeof(*status));
+  svcts_fill_status(st, status);
+  streaming_target_deliver2(st->output,
+                            streaming_msg_create_data(SMT_TIMESHIFT_STATUS, status));
+}
+
+static void
+svcts_speed_notify ( svcts_t *st )
+{
+  streaming_target_deliver2(st->output,
+                            streaming_msg_create_code(SMT_SPEED, st->speed));
+}
+
+/* **************************************************************************
+ * Live side
+ * *************************************************************************/
+
+static void
+svcts_live_reset ( svcts_t *st )
+{
+  if (st->state != SVCTS_LIVE) {
+    st->state = SVCTS_LIVE;
+    st->speed = 100;
+    st->reset = 1;
+    svcts_speed_notify(st);
+    tvh_cond_signal(&st->cond, 0);
+  }
+
+  svcts_out_reset(st);
+  memset(st->ring, 0, sizeof(st->ring));
+  memset(st->is_video, 0, sizeof(st->is_video));
+  st->ring_pos = 0;
+  st->calibrated = 0;
+  st->live_time = 0;
+  st->live_mono = 0;
+  st->live_pts_off = 0;
+  st->live_rebase_pending = 0;
+  st->live_rebase_wait_video = 0;
+  st->live_rebase_deadline = 0;
+  st->live_last_dts = PTS_UNSET;
+  st->live_last_video_dts = PTS_UNSET;
+  svcts_start_set(&st->live_start, NULL);
+  st->live_start_seq = 0;
+  svcts_start_set(&st->out_start, NULL);
+  st->out_start_seq = 0;
+}
+
+static int
+svcts_live_rebase ( svcts_t *st, streaming_message_t *sm )
+{
+  th_pkt_t *pkt = sm->sm_data;
+  th_pkt_t *n;
+  int64_t clock;
+  int64_t adjusted;
+  int64_t last_clock;
+  int64_t target;
+
+  if (st->live_rebase_pending) {
+
+    /*
+     * globalheaders may release several held A/V packets after the new
+     * START.  For a video service anchor the new source generation on
+     * video, otherwise an audio stream with a different presentation
+     * offset could establish the global clock correction.
+     */
+    if (st->live_rebase_wait_video && !SCT_ISVIDEO(pkt->pkt_type)) {
+      if (st->live_rebase_deadline == 0 ||
+          mclk() < st->live_rebase_deadline)
+        return 0;
+
+      /*
+       * The START advertised video but none arrived in time.  Do not
+       * stall the complete HTSP subscription indefinitely; fall back to
+       * the first usable non-teletext stream as clock anchor.
+       */
+      st->live_rebase_wait_video = 0;
+      st->live_rebase_deadline = 0;
+
+      tvhwarn(LS_TIMESHIFT,
+              "svcts: no video arrived after source reconfiguration; "
+              "using another stream as decode-clock anchor");
+    }
+
+    if (pkt->pkt_type == SCT_TELETEXT)
+      return 0;
+
+    /*
+     * A decoder is restarted by the new START, so continuity of DTS is
+     * the hard requirement here.  PTS can legitimately lead DTS because
+     * of B-frame reordering; anchoring on PTS allowed the new DTS to move
+     * backwards across a source reconfiguration.
+     */
+    clock = pkt->pkt_dts != PTS_UNSET ? pkt->pkt_dts : pkt->pkt_pts;
+
+    if (clock == PTS_UNSET)
+      return 0;
+
+    adjusted = clock + st->live_pts_off;
+
+    /*
+     * Compare decoder clock with decoder clock.  live_time is a
+     * presentation timeline and normally prefers PTS, so it must not be
+     * the primary source-generation anchor for reordered video.
+     */
+    last_clock = st->live_rebase_wait_video ?
+                   st->live_last_video_dts : st->live_last_dts;
+
+    /*
+     * Defensive fallback for streams which provided no usable DTS before
+     * the reconfiguration.
+     */
+    if (last_clock == PTS_UNSET && st->live_time > 0)
+      last_clock = ts_rescale_inv(st->live_time, 1000000);
+
+    if (last_clock != PTS_UNSET) {
+      target = svcts_packet_rebase_target(last_clock, adjusted);
+
+      /*
+       * Unlike ordinary packet ordering inside one generation, a new
+       * source generation must never restart the client decode clock at
+       * or behind the old one.
+       */
+      if (target <= last_clock)
+        target = last_clock + 1;
+
+      if (target != adjusted) {
+        st->live_pts_off += target - adjusted;
+        tvhdebug(LS_TIMESHIFT,
+                 "svcts: rebase live decode clock after source "
+                 "reconfiguration: offset=%"PRId64,
+                 st->live_pts_off);
+      }
+    }
+
+    st->live_rebase_pending = 0;
+    st->live_rebase_wait_video = 0;
+    st->live_rebase_deadline = 0;
+  }
+
+  if (st->live_pts_off == 0)
+    return 1;
+
+  n = pkt_copy_shallow(pkt);
+  if (n == NULL)
+    return 0;
+
+  pkt_ref_dec(pkt);
+  sm->sm_data = n;
+
+  if (n->pkt_pts != PTS_UNSET)
+    n->pkt_pts += st->live_pts_off;
+  if (n->pkt_dts != PTS_UNSET)
+    n->pkt_dts += st->live_pts_off;
+  if (n->pkt_pcr != PTS_UNSET)
+    n->pkt_pcr += st->live_pts_off;
+
+  return 1;
+}
+
+static void
+svcts_live_seen ( svcts_t *st, th_pkt_t *pkt )
+{
+  svcts_key_t *k;
+  int64_t t;
+
+  if (pkt->pkt_type == SCT_TELETEXT)
+    return;
+
+  if (SCT_ISVIDEO(pkt->pkt_type))
+    st->is_video[pkt->pkt_componentindex] = 1;
+
+  /*
+   * Keep the newest already-rebased live decoder clocks.  They survive a
+   * SOURCE_RECONFIGURED boundary long enough to anchor the first packet
+   * of the next source generation.
+   */
+  if (pkt->pkt_dts != PTS_UNSET) {
+    st->live_last_dts = pkt->pkt_dts;
+    if (SCT_ISVIDEO(pkt->pkt_type))
+      st->live_last_video_dts = pkt->pkt_dts;
+  }
+
+  if (pkt->pkt_pts != PTS_UNSET || pkt->pkt_dts != PTS_UNSET) {
+    t = svcts_pkt_time(pkt);
+    if (t > st->live_time) {
+      st->live_time = t;
+      st->live_mono = mclk();
+    }
+  }
+  k = &st->ring[st->ring_pos];
+  if (svcts_key(pkt, k, !svcts_start_has_video(st->live_start))) {
+    k->dts = pkt->pkt_dts;
+    st->ring_pos = (st->ring_pos + 1) % SVCTS_RING;
+  }
+}
+
+static void
+svcts_input ( void *opaque, streaming_message_t *sm )
+{
+  svcts_t *st = opaque;
+  streaming_start_t *ss;
+  th_pkt_t *pkt;
+
+  tvh_mutex_lock(&st->lock);
+
+  switch (sm->sm_type) {
+  case SMT_PACKET:
+    if (!svcts_live_rebase(st, sm)) {
+      streaming_msg_free(sm);
+      break;
+    }
+    pkt = sm->sm_data;
+    svcts_live_seen(st, pkt);
+
+    if (st->state == SVCTS_LIVE && svcts_out_new(st, pkt)) {
+      if (pkt->pkt_type != SCT_TELETEXT)
+        st->last_time = svcts_pkt_time(pkt);
+      streaming_target_deliver2(st->output, sm);
+    } else {
+      streaming_msg_free(sm);
+    }
+    break;
+
+  case SMT_SPEED:
+  case SMT_SKIP:
+    TAILQ_INSERT_TAIL(&st->ctrl, sm, sm_link);
+    tvh_cond_signal(&st->cond, 0);
+    break;
+
+  case SMT_START:
+    ss = sm->sm_data;
+
+    /* START may occasionally arrive without a preceding STOP. */
+    if (st->live_start) {
+      st->live_rebase_pending = 1;
+
+      /*
+       * The old live calibration belongs to the previous source
+       * timeline.  Preserve it while replaying historical cache data.
+       */
+      if (st->state == SVCTS_LIVE)
+        st->calibrated = 0;
+    }
+
+    svcts_start_set(&st->live_start, ss);
+
+    /*
+     * Remember the cache generation together with this particular
+     * globalheaders START. Do not look the generation up later when
+     * returning to live: the raw cache may already have advanced to
+     * another START while globalheaders is still preparing it.
+     */
+    st->live_start_seq = st->sb ? svcbuf_start_seq(st->sb) : 0;
+
+    memset(st->ring, 0, sizeof(st->ring));
+    memset(st->is_video, 0, sizeof(st->is_video));
+    st->ring_pos = 0;
+
+    if (st->live_rebase_pending) {
+      st->live_rebase_wait_video = svcts_start_has_video(ss);
+      st->live_rebase_deadline =
+        st->live_rebase_wait_video ? mclk() + sec2mono(2) : 0;
+    }
+
+    if (st->state == SVCTS_LIVE) {
+      svcts_start_set(&st->out_start, ss);
+      st->out_start_seq = st->live_start_seq;
+      streaming_target_deliver2(st->output, sm);
+    } else {
+      /* This START belongs to the live head, not to the historical
+       * position currently being played. */
+      streaming_msg_free(sm);
+    }
+    break;
+
+  case SMT_STOP:
+    if (sm->sm_code == SM_CODE_SOURCE_RECONFIGURED) {
+      st->live_rebase_pending = 1;
+
+      /* The old live calibration belongs to the previous source timeline. */
+      if (st->state == SVCTS_LIVE)
+        st->calibrated = 0;
+      memset(st->ring, 0, sizeof(st->ring));
+      memset(st->is_video, 0, sizeof(st->is_video));
+      st->ring_pos = 0;
+
+      if (st->state == SVCTS_LIVE) {
+        svcts_out_reset(st);
+        streaming_target_deliver2(st->output, sm);
+      } else {
+        /* The cache will replay this boundary at the historical point. */
+        streaming_msg_free(sm);
+      }
+    } else {
+      svcts_live_reset(st);
+      streaming_target_deliver2(st->output, sm);
+    }
+    break;
+
+  default:
+    streaming_target_deliver2(st->output, sm);
+    break;
+  }
+
+  tvh_mutex_unlock(&st->lock);
+}
+
+static htsmsg_t *
+svcts_input_info ( void *opaque, htsmsg_t *list )
+{
+  svcts_t *st = opaque;
+  streaming_target_t *out = st->output;
+  htsmsg_add_str(list, NULL, "channel cache timeshift input");
+  return out->st_ops.st_info(out->st_opaque, list);
+}
+
+static streaming_ops_t svcts_input_ops = {
+  .st_cb   = svcts_input,
+  .st_info = svcts_input_info
+};
+
+/* **************************************************************************
+ * Replay: the private parser's output, in the client's time base
+ * *************************************************************************/
+
+/* Line a replayed video frame up with the same frame sent live.  Only a
+ * frame seen once counts: identical ones (black frames...) would mislead. */
+static void
+svcts_calibrate ( svcts_t *st, th_pkt_t *pkt )
+{
+  svcts_key_t k;
+  const svcts_key_t *match = NULL;
+  int i;
+
+  if (!svcts_key(pkt, &k, !svcts_start_has_video(st->rd_start)))
+    return;
+  for (i = 0; i < SVCTS_RING; i++) {
+    const svcts_key_t *r = &st->ring[i];
+    if (r->used && r->index == k.index && r->len == k.len && r->crc == k.crc) {
+      if (match)
+        return;
+      match = r;
+    }
+  }
+  if (match == NULL)
+    return;
+  st->off = (pkt->pkt_dts & PTS_MASK) - match->dts;
+  st->expect = match->dts;
+  st->calibrated = 1;
+  tvhdebug(LS_TIMESHIFT, "svcts: calibrated, source - client = %"PRId64, st->off);
+}
+
+static void
+svcts_replay_rebase ( svcts_t *st, const th_pkt_t *pkt )
+{
+  int64_t clock;
+  int64_t raw;
+  int64_t adjusted;
+  int64_t target;
+  int64_t rebased;
+
+  if (!st->replay_rebase_pending)
+    return;
+
+  /*
+   * Source generations must join on decoder time.  PTS may legitimately
+   * lead DTS by a different amount after a codec/source reconfiguration.
+   */
+  clock = pkt->pkt_dts != PTS_UNSET ? pkt->pkt_dts : pkt->pkt_pts;
+  if (clock == PTS_UNSET || pkt->pkt_type == SCT_TELETEXT)
+    return;
+
+  raw = clock & PTS_MASK;
+  target = st->replay_anchor;
+
+  adjusted = st->calibrated ?
+               svcts_unwrap(raw - st->off, target) : PTS_UNSET;
+
+  if (st->replay_rebase_exact) {
+    /*
+     * A seek jumped directly into another source-clock generation.
+     * Preserve the old offset when it still maps this block close to its
+     * monotonic cache position; otherwise establish a new one.
+     */
+    if (!st->calibrated ||
+        adjusted < target - 2 * 90000 ||
+        adjusted > target + 2 * 90000) {
+      st->off = raw - target;
+      adjusted = target;
+    }
+  } else {
+    /*
+     * Sequential replay has the monotonic cache position of the new
+     * generation as its anchor. Preserve source timing when it agrees
+     * with that position; otherwise the new source clock belongs to a
+     * different generation and must be joined to the cache timeline.
+     */
+    if (!st->calibrated ||
+        adjusted < target - 2 * 90000 ||
+        adjusted > target + 2 * 90000) {
+      rebased = target + 1;
+    } else {
+      rebased = adjusted;
+      if (rebased <= target)
+        rebased = target + 1;
+    }
+
+    if (!st->calibrated || rebased != adjusted) {
+      st->off = raw - rebased;
+      adjusted = rebased;
+    }
+  }
+
+  st->expect = adjusted;
+  st->calibrated = 1;
+  st->replay_rebase_pending = 0;
+
+  tvhdebug(LS_TIMESHIFT,
+           "svcts: replay clock generation changed, offset=%"PRId64,
+           st->off);
+}
+
+static void
+svcts_sink ( void *opaque, streaming_message_t *sm )
+{
+  svcts_t *st = opaque;
+  streaming_start_t *ss;
+  th_pkt_t *pkt;
+  th_pkt_t *n;
+  svcts_pkt_t *p;
+
+  if (sm->sm_type == SMT_START) {
+    /*
+     * This START has passed through the private globalheaders target, so
+     * it contains the same codec metadata an ordinary HTSP START gets.
+     */
+    ss = sm->sm_data;
+
+    tvh_mutex_lock(&st->lock);
+    svcts_start_set(&st->rd_start, ss);
+    st->rd_start_seq = st->read_start_seq;
+    tvh_mutex_unlock(&st->lock);
+
+    streaming_msg_free(sm);
+    return;
+  }
+
+  if (sm->sm_type != SMT_PACKET) {
+    streaming_msg_free(sm);
+    return;
+  }
+
+  pkt = sm->sm_data;
+
+  tvh_mutex_lock(&st->lock);
+
+  svcts_replay_rebase(st, pkt);
+
+  if (!st->calibrated)
+    svcts_calibrate(st, pkt);
+
+  if (st->calibrated &&
+      st->rd_start &&
+      pkt->pkt_dts != PTS_UNSET) {
+    if ((n = pkt_copy_shallow(pkt)) == NULL)
+      goto done;
+
+    n->pkt_dts =
+      svcts_unwrap((pkt->pkt_dts & PTS_MASK) - st->off, st->expect);
+    st->expect = n->pkt_dts;
+
+    n->pkt_pts = pkt->pkt_pts == PTS_UNSET ? n->pkt_dts :
+      svcts_unwrap((pkt->pkt_pts & PTS_MASK) - st->off, n->pkt_dts);
+
+    if (pkt->pkt_pcr != PTS_UNSET)
+      n->pkt_pcr =
+        svcts_unwrap((pkt->pkt_pcr & PTS_MASK) - st->off, n->pkt_dts);
+
+    if (n->pkt_dts != PTS_UNSET && n->pkt_type != SCT_TELETEXT)
+      st->replay_last_dts = n->pkt_dts;
+
+    if ((p = calloc(1, sizeof(*p))) == NULL) {
+      pkt_ref_dec(n);
+      goto done;
+    }
+    p->pkt = n;
+    p->time = svcts_pkt_time(n);
+    p->start = st->rd_start;
+    p->start_seq = st->rd_start_seq;
+    streaming_start_ref(p->start);
+
+    TAILQ_INSERT_TAIL(&st->q, p, link);
+  }
+
+done:
+  tvh_mutex_unlock(&st->lock);
+  streaming_msg_free(sm);
+}
+
+static htsmsg_t *
+svcts_sink_info ( void *opaque, htsmsg_t *list )
+{
+  (void)opaque;
+  htsmsg_add_str(list, NULL, "channel cache timeshift replay");
+  return list;
+}
+
+static streaming_ops_t svcts_sink_ops = {
+  .st_cb   = svcts_sink,
+  .st_info = svcts_sink_info
+};
+
+/* Drop the replay pipeline (lock held, released meanwhile) */
+static void
+svcts_replay_drop ( svcts_t *st )
+{
+  streaming_target_t *parser = st->parser;
+  streaming_target_t *headers = st->headers;
+  svcbuf_reader_t *rd = st->rd;
+  svcbuf_t *old = st->sb_old;
+
+  st->parser = NULL;
+  st->headers = NULL;
+  st->rd = NULL;
+  st->rd_service = NULL;
+  st->sb_old = NULL;
+  st->reset = 0;
+
+  svcts_queue_clear(st);
+  svcts_start_set(&st->rd_start, NULL);
+
+  st->rd_start_seq = 0;
+  st->read_start_seq = 0;
+  st->replay_prev_seq = 0;
+  st->replay_rebase_pending = 0;
+  st->replay_rebase_exact = 0;
+  st->replay_last_dts = PTS_UNSET;
+  st->expect = PTS_UNSET;
+  st->calibrated = 0;
+  st->off = 0;
+
+  st->skip_to = 0;
+  st->skip_pending = 0;
+  st->skip_back = 0;
+  st->reanchor = 0;
+
+  if (st->skip_reply) {
+    ((streaming_skip_t *)st->skip_reply->sm_data)->type = SMT_SKIP_ERROR;
+    streaming_target_deliver2(st->output, st->skip_reply);
+    st->skip_reply = NULL;
+  }
+
+  tvh_mutex_unlock(&st->lock);
+
+  if (parser)
+    parser_destroy(parser);
+  if (headers)
+    globalheaders_destroy(headers);
+  if (rd)
+    svcbuf_reader_destroy(rd);
+  if (old)
+    svcbuf_release(old);
+
+  tvh_mutex_lock(&st->lock);
+}
+
+/* Replay from 'time' (us, client base): a fresh parser, as data restarts
+ * at an arbitrary point (lock held, released meanwhile).  0 on failure. */
+static int
+svcts_replay_open ( svcts_t *st, int64_t time )
+{
+  streaming_target_t *parser = st->parser;
+  streaming_target_t *headers = st->headers;
+  streaming_target_t *new_headers;
+  svcbuf_t *sb = st->sb;
+  service_t *t;
+  uint64_t prev_seq;
+  int64_t mono;
+
+  if (sb == NULL || st->live_time == 0)
+    return 0;
+
+  mono = st->live_mono -
+         (st->live_time - time) -
+         SVCTS_PREROLL;
+
+  prev_seq = st->read_start_seq ?
+               st->read_start_seq : st->replay_prev_seq;
+
+  st->parser = NULL;
+  st->headers = NULL;
+
+  svcts_queue_clear(st);
+  svcts_start_set(&st->rd_start, NULL);
+
+  st->at_head = 0;
+  st->replay_prev_seq = prev_seq;
+  st->read_start_seq = 0;
+  st->rd_start_seq = 0;
+  st->replay_rebase_pending = 0;
+  st->replay_rebase_exact = 0;
+  st->replay_last_dts = PTS_UNSET;
+  st->expect = PTS_UNSET;
+
+  /*
+   * svcts_fill() releases st->lock, so svcts_attach() can have pointed
+   * st->sb at another service's cache since the reader was made.  Keeping
+   * it would seek the previous cache and feed the client the previous
+   * channel's MPEG-TS, so drop it and read the one we are attached to.
+   */
+  if (st->rd != NULL && st->rd_service != svcbuf_service(sb)) {
+    svcbuf_reader_destroy(st->rd);
+    st->rd = NULL;
+    st->rd_service = NULL;
+  }
+
+  if (st->rd == NULL) {
+    st->rd = svcbuf_reader_create(sb);
+    if (st->rd == NULL)
+      return 0;
+    st->rd_service = svcbuf_service(sb);
+  }
+
+  svcbuf_reader_seek(st->rd, mono);
+  t = st->rd_service;
+
+  tvh_mutex_unlock(&st->lock);
+
+  if (parser)
+    parser_destroy(parser);
+  if (headers)
+    globalheaders_destroy(headers);
+
+  /*
+   * Historical raw START -> replay parser -> private globalheaders ->
+   * svcts sink.  This makes replay STARTs equivalent to live HTSP STARTs.
+   */
+  new_headers = globalheaders_create(&st->sink);
+
+  tvh_mutex_lock(&t->s_stream_mutex);
+  parser = parser_create_replay(new_headers, t);
+  tvh_mutex_unlock(&t->s_stream_mutex);
+
+  tvh_mutex_lock(&st->lock);
+
+  st->headers = new_headers;
+  st->parser = parser;
+
+  return parser != NULL;
+}
+
+/* What a read got, given up: it no longer follows on */
+static void
+svcts_fill_drop ( pktbuf_t *pb, streaming_start_t *ss )
+{
+  if (pb)
+    pktbuf_ref_dec(pb);
+  if (ss)
+    streaming_start_unref(ss);
+}
+
+/* Parse one more chunk of the cache (lock held, released meanwhile).
+ * 1 when data was parsed, 0 at the head, -1 on error, 2 when the position
+ * expired under the reader (nothing parsed: the data no longer follows) */
+static int
+svcts_fill ( svcts_t *st )
+{
+  svcbuf_reader_t *rd = st->rd;
+  streaming_target_t *parser = st->parser;
+  service_t *t = st->rd_service;
+  streaming_message_t *start_sm = NULL;
+  streaming_start_t *ss = NULL;
+  pktbuf_t *pb = NULL;
+  uint64_t seq = 0;
+  int64_t block_mono = 0;
+  int64_t anchor_us;
+  int r;
+
+  if (rd == NULL || parser == NULL)
+    return -1;
+
+  tvh_mutex_unlock(&st->lock);
+
+  r = svcbuf_reader_read_map
+        (rd, &pb, &ss, &seq, &block_mono);
+
+  /* lost even with nothing read: a pending seek must not wait on it */
+  if (r >= 0 && svcbuf_reader_lost(rd)) {
+    svcts_fill_drop(pb, ss);
+    tvh_mutex_lock(&st->lock);
+    return 2;
+  }
+
+  if (r <= 0) {
+    if (ss)
+      streaming_start_unref(ss);
+    tvh_mutex_lock(&st->lock);
+    return r;
+  }
+
+  if (ss == NULL) {
+    tvherror(LS_TIMESHIFT,
+             "svcts: cached MPEG-TS has no historical stream map");
+    pktbuf_ref_dec(pb);
+    tvh_mutex_lock(&st->lock);
+    return -1;
+  }
+
+  tvh_mutex_lock(&st->lock);
+
+  if (seq != st->read_start_seq) {
+    if (st->read_start_seq != 0) {
+      /*
+       * Sequential playback crossed a historical START. Anchor the new
+       * generation to when its cached block actually arrived. This keeps
+       * a real source outage in the timeline, but prevents an unrelated
+       * source-clock jump from becoming artificial dead air.
+       */
+      anchor_us = st->live_time - (st->live_mono - block_mono);
+      st->replay_anchor = ts_rescale_inv(anchor_us, 1000000);
+
+      /*
+       * Block time is only an arrival-time estimate. Never let it move
+       * behind data which has already been handed to the client.
+       */
+      if (st->replay_last_dts != PTS_UNSET &&
+          st->replay_anchor <= st->replay_last_dts)
+        st->replay_anchor = st->replay_last_dts + 1;
+      if (st->expect != PTS_UNSET &&
+          st->replay_anchor <= st->expect)
+        st->replay_anchor = st->expect + 1;
+
+      st->replay_rebase_pending = 1;
+      st->replay_rebase_exact = 0;
+
+    } else if (st->replay_prev_seq != 0 &&
+               seq != st->replay_prev_seq) {
+      /*
+       * A seek jumped directly into another stream-clock generation.
+       * Anchor it from the cache's monotonic position.
+       */
+      anchor_us = st->live_time - (st->live_mono - block_mono);
+      st->replay_anchor = ts_rescale_inv(anchor_us, 1000000);
+      st->replay_rebase_pending = 1;
+      st->replay_rebase_exact = 1;
+    }
+
+    st->read_start_seq = seq;
+    st->replay_prev_seq = 0;
+
+    /*
+     * svcbuf_reader_read_map() gave us a shared historical map.
+     * Never mutate it: mark a private copy as random-access cache replay
+     * so private globalheaders does not mistake a late codec-header
+     * repetition for a missing stream.
+     */
+    {
+      streaming_start_t *rss = streaming_start_copy(ss);
+      rss->ss_flags |= STREAMING_START_CACHE_REPLAY;
+
+      streaming_start_unref(ss);
+      ss = NULL;
+
+      start_sm = streaming_msg_create_data(SMT_START, rss);
+    }
+  }
+
+  tvh_mutex_unlock(&st->lock);
+
+  if (ss)
+    streaming_start_unref(ss);
+
+  tvh_mutex_lock(&t->s_stream_mutex);
+
+  if (start_sm)
+    streaming_target_deliver2(parser, start_sm);
+
+  streaming_target_deliver2
+    (parser, streaming_msg_create_data(SMT_MPEGTS, pb));
+
+  tvh_mutex_unlock(&t->s_stream_mutex);
+
+  tvh_mutex_lock(&st->lock);
+  return 1;
+}
+
+/* Going back, start from the last keyframe at or before skip_to, as the
+ * packet timeshift does: parse past the target, then drop what precedes
+ * that keyframe (lock held, released meanwhile) */
+static void
+svcts_skip_back_select ( svcts_t *st )
+{
+  svcts_pkt_t *p;
+  const svcts_pkt_t *kf = NULL;
+
+  st->skip_back = 0;
+
+  /* parse on until the queue reaches past the target, or cannot */
+  for (;;) {
+    p = TAILQ_LAST(&st->q, svcts_pkt_queue);
+    if ((p && p->time > st->skip_to) || st->reset || svcts_fill(st) != 1)
+      break;
+  }
+
+  TAILQ_FOREACH(p, &st->q, link)
+    if (p->time <= st->skip_to && svcts_is_keyframe(p->pkt))
+      kf = p;
+
+  if (kf == NULL)
+    return;
+
+  while ((p = TAILQ_FIRST(&st->q)) != kf) {
+    TAILQ_REMOVE(&st->q, p, link);
+    svcts_pkt_drop(p);
+  }
+
+  st->skip_to = kf->time;
+}
+
+/* Drop from the head of the queue what is not to be shown -- what comes
+ * before the keyframe a skip lands on, or all but keyframes in keyframe
+ * mode -- and return the first packet to show, if any (lock held) */
+static svcts_pkt_t *
+svcts_head ( svcts_t *st )
+{
+  svcts_pkt_t *p = TAILQ_FIRST(&st->q);
+  svcts_pkt_t *n;
+  /*
+   * svcts_is_keyframe() answers for video only, so a generation carrying no
+   * video has no keyframe to land on: requiring one would drop every packet
+   * and leave the seek with nothing to show.
+   */
+  const int have_video = svcts_start_has_video(st->rd_start);
+
+  while (p != NULL &&
+         ((st->skip_pending &&
+           !((!have_video || svcts_is_keyframe(p->pkt)) &&
+             p->time >= st->skip_to)) ||
+          (st->keyframe_mode && have_video && !svcts_is_keyframe(p->pkt)))) {
+    if (st->skip_pending) {
+      st->skip_seen = p->time;
+      if (svcts_is_keyframe(p->pkt))
+        st->skip_seen_kf = p->time;
+    }
+    n = TAILQ_NEXT(p, link);
+    TAILQ_REMOVE(&st->q, p, link);
+    svcts_pkt_drop(p);
+    p = n;
+  }
+
+  if (p != NULL) {
+    st->skip_to = 0;
+    st->skip_pending = 0;
+  }
+
+  return p;
+}
+
+/* Next packet to show, parsing as needed (lock held, released meanwhile);
+ * NULL at the head of the cache or on error */
+static svcts_pkt_t *
+svcts_next ( svcts_t *st )
+{
+  svcts_pkt_t *p;
+  int r;
+
+  if (st->skip_back && st->skip_pending)
+    svcts_skip_back_select(st);
+  for (;;) {
+    if (st->reset)
+      return NULL;
+    if ((p = svcts_head(st)) != NULL)
+      return p;
+    r = svcts_fill(st);
+    if (r == 2) {
+      /* a pause longer than the cache: the position expired.  Go on a
+       * little ahead of the oldest data, as it keeps expiring at 1x. */
+      int64_t t = MIN(svcts_oldest(st) + SVCTS_EXPIRED_GAP, st->live_time);
+      tvhdebug(LS_TIMESHIFT, "svcts: position expired, going on from %"PRId64"s back",
+               (st->live_time - t) / 1000000);
+      if (!svcts_replay_open(st, t))
+        return NULL;
+      svcts_out_reset(st);
+      st->skip_to = t;
+      st->skip_pending = 1;
+      st->reanchor = 1;
+      continue;
+    }
+    if (r <= 0) {
+      st->at_head = 1;
+      return NULL;
+    }
+    st->at_head = 0;
+  }
+}
+
+/* Hand a packet to the client (lock held) */
+static void
+svcts_output ( svcts_t *st, svcts_pkt_t *p )
+{
+  /*
+   * The skip acknowledgement, when there is one, has already been sent by
+   * the caller.  Restore the historical map only now, so an HTSP queue
+   * flush caused by the seek cannot discard it.
+   */
+  if (p->start &&
+      (p->start_seq != st->out_start_seq ||
+       p->start != st->out_start))
+    svcts_output_start(st, p->start, p->start_seq);
+
+  if (svcts_out_new(st, p->pkt)) {
+    if (p->pkt->pkt_type != SCT_TELETEXT)
+      st->last_time = p->time;
+
+    streaming_target_deliver2
+      (st->output, streaming_msg_create_pkt(p->pkt));
+
+    if (p->start)
+      streaming_start_unref(p->start);
+    pkt_ref_dec(p->pkt);
+    free(p);
+  } else {
+    svcts_pkt_drop(p);
+  }
+}
+
+/* Answer a pending skip with the first packet found (lock held) */
+static void
+svcts_skip_answer ( svcts_t *st, const svcts_pkt_t *p )
+{
+  streaming_skip_t *skip = st->skip_reply->sm_data;
+
+  skip->type = SMT_SKIP_ABS_TIME;
+  skip->time = ts_rescale_inv(p->time, 1000000);
+  st->last_time = p->time;
+  svcts_fill_status(st, &skip->timeshift);
+  streaming_target_deliver2(st->output, st->skip_reply);
+  st->skip_reply = NULL;
+  st->pause_time = p->time;
+  st->mono_play = mclk();
+  st->mono_status = st->mono_play;
+}
+
+/* Back to live: what the client already has is dropped by its DTS */
+static void
+svcts_go_live ( svcts_t *st )
+{
+  tvhdebug(LS_TIMESHIFT, "svcts: back to live");
+  st->state = SVCTS_LIVE;
+  st->speed = 100;
+  st->keyframe_mode = 0;
+  st->reset = 1;
+  svcts_speed_notify(st);
+}
+
+static void
+svcts_sync_live_start ( svcts_t *st )
+{
+  uint64_t seq;
+
+  if (st->live_start == NULL)
+    return;
+
+  /*
+   * Compare against the generation captured when this exact live START
+   * arrived from globalheaders. The svcbuf itself may already have seen a
+   * newer raw START, so looking up sb->start_seq here would race with a
+   * source reconfiguration.
+   */
+  seq = st->live_start_seq;
+
+  if (seq && st->out_start_seq == seq) {
+    tvhdebug(LS_TIMESHIFT,
+             "svcts: live map generation %"PRId64
+             " already delivered by replay; keeping decoder state",
+             (int64_t)seq);
+
+    /*
+     * Replay has already delivered the same stream-map generation.
+     * Switch the internal reference back to the live map without sending
+     * a redundant START and forcing downstream decoders to reinitialise.
+     */
+    svcts_start_set(&st->out_start, st->live_start);
+    return;
+  }
+
+  /*
+   * The client has not seen this live generation. This includes jumping
+   * directly to live across a PID/PMT or other stream-map change.
+   */
+  svcts_output_start(st, st->live_start, seq);
+}
+
+/* A seek that read up to the head of the cache without finding where it
+ * asked for -- a point newer than the cache holds yet, or one the replay's
+ * time base does not reach -- asked for live: answered so, as a seek past
+ * the live point is (lock held) */
+static void
+svcts_skip_to_live ( svcts_t *st )
+{
+  streaming_message_t *ctrl = st->skip_reply;
+  streaming_skip_t *skip = ctrl->sm_data;
+
+  tvhdebug(LS_TIMESHIFT, "svcts: skip to %"PRId64" reached the head "
+           "(newest packet %"PRId64", keyframe %"PRId64", %s); live",
+           st->skip_to, st->skip_seen, st->skip_seen_kf,
+           svcts_start_has_video(st->rd_start) ? "video" : "no video");
+  st->skip_reply = NULL;
+  st->skip_pending = 0;
+  st->skip_to = 0;
+  svcts_go_live(st);
+  skip->type = SMT_SKIP_ABS_TIME;
+  skip->time = ts_rescale_inv(st->live_time, 1000000);
+  svcts_fill_status(st, &skip->timeshift);
+  streaming_target_deliver2(st->output, ctrl);
+  svcts_sync_live_start(st);
+}
+
+/* Start of the cache reached going back: pause there */
+static void
+svcts_at_start ( svcts_t *st )
+{
+  tvhdebug(LS_TIMESHIFT, "svcts: start of the cache, pause");
+  st->state = SVCTS_PAUSE;
+  st->speed = 0;
+  st->keyframe_mode = 0;
+  st->pause_time = st->last_time;
+  svcts_speed_notify(st);
+}
+
+/* Parse from where the replay was opened up to last_time, keeping the last
+ * keyframe on the way and dropping everything else, and anything before
+ * `oldest`, which may be the client's tune-in.  In a generation with no
+ * video any packet will do, so long as it is SVCTS_AUDIO_STEP back: going
+ * back a frame at a time would re-parse the cache for every one of them
+ * (lock held) */
+static svcts_pkt_t *
+svcts_rewind_scan ( svcts_t *st, int64_t oldest )
+{
+  const int video = svcts_start_has_video(st->rd_start);
+  const int64_t until = video ? st->last_time : st->last_time - SVCTS_AUDIO_STEP;
+  svcts_pkt_t *p = TAILQ_FIRST(&st->q);
+  svcts_pkt_t *n;
+  svcts_pkt_t *kf = NULL;
+
+  for (;;) {
+    if (p == NULL && !st->reset && svcts_fill(st) == 1) {
+      p = TAILQ_FIRST(&st->q);
+      continue;
+    }
+    if (p == NULL || st->reset || p->time >= until)
+      break;
+
+    n = TAILQ_NEXT(p, link);
+    TAILQ_REMOVE(&st->q, p, link);
+
+    if (p->time < oldest || (video && !svcts_is_keyframe(p->pkt))) {
+      svcts_pkt_drop(p);
+    } else {
+      if (kf)
+        svcts_pkt_drop(kf);
+      kf = p;
+    }
+
+    p = n;
+  }
+  return kf;
+}
+
+/* Rewind: find the last keyframe before last_time (lock held) */
+static svcts_pkt_t *
+svcts_rewind_find ( svcts_t *st )
+{
+  svcts_pkt_t *kf;
+  int64_t step = SVCTS_REWIND_STEP;
+  int64_t from;
+  int64_t oldest;
+  int at_start;
+
+  for (;;) {
+    oldest = svcts_oldest(st);
+    from = st->last_time - step;
+    at_start = from <= oldest;
+
+    if (at_start)
+      from = oldest;
+
+    if (!svcts_replay_open(st, from + SVCTS_PREROLL))
+      return NULL;
+
+    kf = svcts_rewind_scan(st, oldest);
+
+    if (kf || at_start || st->reset)
+      return kf;
+
+    step *= 2;
+  }
+}
+
+/* The next packet to play, or NULL and in *wait how long to wait first:
+ * backwards, the keyframe before the last one shown, stopping at the start
+ * of the cache; forwards, the head of the queue, going live at the head of
+ * the cache (lock held) */
+static svcts_pkt_t *
+svcts_play_next ( svcts_t *st, int64_t *wait )
+{
+  svcts_pkt_t *p;
+
+  *wait = 0;
+  if (st->speed < 0) {
+    /* a seek while going back lands as any seek does, on the frame found
+       at its target -- the first one there is, at the start of what may be
+       reached -- and is answered with it; going back carries on from it */
+    if (st->skip_pending) {
+      if (st->rw_pkt) {
+        svcts_pkt_drop(st->rw_pkt);
+        st->rw_pkt = NULL;
+      }
+      p = svcts_next(st);
+      if (p == NULL && st->at_head && st->skip_reply && !st->reset)
+        svcts_skip_to_live(st);
+      else if (p == NULL && !st->reset)
+        *wait = ms2mono(100);
+      return p;
+    }
+    if (st->rw_pkt != NULL)
+      return st->rw_pkt;
+    st->rw_pkt = svcts_rewind_find(st);
+    if (st->reset)
+      return NULL;
+    if (st->rw_pkt == NULL)
+      svcts_at_start(st);
+    return st->rw_pkt;
+  }
+
+  p = svcts_next(st);
+  if (st->reset || st->state != SVCTS_PLAY)
+    return NULL;
+  if (p == NULL && st->at_head && st->skip_reply) {
+    svcts_skip_to_live(st);
+  } else if (p == NULL && st->at_head) {
+    svcts_go_live(st);
+    svcts_sync_live_start(st);
+  } else if (p == NULL) {
+    *wait = ms2mono(100);
+  }
+  return p;
+}
+
+/* PLAY: hand over what is due; returns how long to wait (lock held) */
+static int64_t
+svcts_play ( svcts_t *st )
+{
+  svcts_pkt_t *p;
+  int64_t now;
+  int64_t deliver;
+  int64_t w;
+
+  for (;;) {
+    now = mclk();
+
+    /* back to the thread for a request, or for the status that is due: a
+       client that is behind -- going back on a slow CPU -- may never catch
+       up, and its seeks would wait for it to */
+    if (!TAILQ_EMPTY(&st->ctrl) || now >= st->mono_status + sec2mono(1))
+      return 0;
+
+    p = svcts_play_next(st, &w);
+    if (p == NULL)
+      return w;
+
+    if (st->skip_reply)
+      svcts_skip_answer(st, p);
+    if (st->reanchor) {
+      st->reanchor = 0;
+      st->pause_time = p->time;
+      st->mono_play = now;
+      svcts_out_reset(st);
+      svcts_status(st);
+    }
+
+    deliver = st->pause_time +
+              ((now - st->mono_play) + TIMESHIFT_PLAY_BUF) * st->speed / 100;
+    if (st->speed > 0 ? p->time > deliver : p->time < deliver) {
+      w = llabs(p->time - deliver) * 100 / llabs(st->speed);
+      return MIN(MAX(w, ms2mono(1)), sec2mono(1));
+    }
+
+    if (p == st->rw_pkt) {
+      st->rw_pkt = NULL;
+      st->out_dts[p->pkt->pkt_componentindex] = PTS_UNSET;  /* going back */
+    } else {
+      TAILQ_REMOVE(&st->q, p, link);
+    }
+    svcts_output(st, p);
+    if (st->keyframe_mode)
+      svcts_status(st);   /* as the packet timeshift does in keyframe mode */
+  }
+}
+
+/* PAUSE after a skip: show the frame skipped to (lock held) */
+static void
+svcts_pause_skip ( svcts_t *st )
+{
+  svcts_pkt_t *p = svcts_next(st);
+  if (p == NULL && st->at_head && st->skip_reply && !st->reset)
+    svcts_skip_to_live(st);
+  if (p == NULL || st->reset)
+    return;
+  svcts_skip_answer(st, p);
+  TAILQ_REMOVE(&st->q, p, link);
+  svcts_output(st, p);
+}
+
+/* **************************************************************************
+ * Requests
+ * *************************************************************************/
+
+/* Leave live: replay from just before the live point, calibrate against
+ * the packets the client got, and go on from the last one (lock held) */
+static int
+svcts_enter ( svcts_t *st )
+{
+  if (st->sb == NULL || st->live_time == 0)
+    return 0;
+  if (!svcts_replay_open(st, st->live_time - SVCTS_CALIB_BACK + SVCTS_PREROLL))
+    return 0;
+  while (!st->calibrated && !st->reset) {
+    if (svcts_fill(st) != 1)
+      break;
+  }
+  if (!st->calibrated) {
+    tvhwarn(LS_TIMESHIFT, "svcts: unable to line the cache up with the stream");
+    return 0;
+  }
+  /* what the client already has is dropped on the way out, by its DTS */
+  st->pause_time = st->last_time;
+  st->mono_play = mclk();
+  return 1;
+}
+
+/* Carry on from last_time again: after a change of direction or of
+ * keyframe mode, the queued packets do not follow on (lock held) */
+static void
+svcts_reposition ( svcts_t *st )
+{
+  int i;
+
+  if (svcts_replay_open(st, st->last_time)) {
+    /* the client has the frame on screen: carry on after it, with the
+     * other streams from there */
+    for (i = 0; i < SVCTS_NSTREAMS; i++)
+      if (!st->is_video[i])
+        st->out_dts[i] = PTS_UNSET;
+    st->skip_to = st->last_time;
+    st->skip_pending = 1;
+    st->skip_back = 0;
+  }
+}
+
+static void
+svcts_speed ( svcts_t *st, streaming_message_t *ctrl )
+{
+  int speed = ctrl->sm_code;
+  int kf;
+
+  if (speed > 3200)  speed = 3200;
+  if (speed < -3200) speed = -3200;
+
+  if (st->state == SVCTS_LIVE) {
+    if (speed >= 100 || !svcts_enter(st))
+      speed = 100;
+    else
+      tvhdebug(LS_TIMESHIFT, "svcts: enter timeshift mode");
+  }
+
+  if (st->state != SVCTS_LIVE || speed != 100) {
+    kf = speed < 0 || speed > 400;
+    /* leaving a rewind, or keyframes for every frame: the queue does not
+     * follow on from what was last shown */
+    if (st->state != SVCTS_LIVE &&
+        ((st->speed < 0 && speed >= 0) || (st->keyframe_mode && !kf)))
+      svcts_reposition(st);
+    if (speed != st->speed || st->state == SVCTS_LIVE) {
+      st->pause_time = st->last_time;
+      st->mono_play = mclk();
+    }
+    if (st->rw_pkt && speed >= 0) {
+      svcts_pkt_drop(st->rw_pkt);
+      st->rw_pkt = NULL;
+    }
+    st->keyframe_mode = kf;
+    st->state = speed == 0 ? SVCTS_PAUSE : SVCTS_PLAY;
+    tvhdebug(LS_TIMESHIFT, "svcts: change speed %d", speed);
+  }
+  st->speed = speed;
+  ctrl->sm_code = speed;
+  streaming_target_deliver2(st->output, ctrl);
+}
+
+static void
+svcts_skip ( svcts_t *st, streaming_message_t *ctrl )
+{
+  streaming_skip_t *skip = ctrl->sm_data;
+  int64_t t;
+  int64_t oldest;
+  int64_t cur;
+  int sync_live;
+
+  switch (skip->type) {
+  case SMT_SKIP_LIVE:
+    sync_live = st->state != SVCTS_LIVE;
+    if (sync_live)
+      svcts_go_live(st);
+    skip->type = SMT_SKIP_ABS_TIME;
+    skip->time = ts_rescale_inv(st->live_time, 1000000);
+    svcts_fill_status(st, &skip->timeshift);
+    streaming_target_deliver2(st->output, ctrl);
+    if (sync_live)
+      svcts_sync_live_start(st);
+    return;
+  case SMT_SKIP_ABS_TIME:
+  case SMT_SKIP_REL_TIME:
+    break;
+  default:
+    goto error;
+  }
+
+  t = ts_rescale(skip->time, 1000000);
+  if (skip->type == SMT_SKIP_REL_TIME)
+    t += st->state == SVCTS_LIVE ? st->live_time : st->last_time;
+  tvhdebug(LS_TIMESHIFT, "svcts: skip to %"PRId64" (live %"PRId64")",
+           t, st->live_time);
+  if (st->sb == NULL || st->live_time == 0)
+    goto error;
+  if (st->state == SVCTS_LIVE && t >= st->live_time - TIMESHIFT_PLAY_BUF)
+    goto error;   /* already live */
+  if (t >= st->live_time) {
+    sync_live = st->state != SVCTS_LIVE;
+    if (sync_live)
+      svcts_go_live(st);
+    skip->type = SMT_SKIP_ABS_TIME;
+    skip->time = ts_rescale_inv(st->live_time, 1000000);
+    svcts_fill_status(st, &skip->timeshift);
+    streaming_target_deliver2(st->output, ctrl);
+    if (sync_live)
+      svcts_sync_live_start(st);
+    return;
+  }
+  oldest = svcts_oldest(st);
+  if (t < oldest)
+    t = oldest;
+
+  if (!st->calibrated && !svcts_enter(st))
+    goto error;
+  cur = st->state == SVCTS_LIVE ? st->live_time : st->last_time;
+  if (!svcts_replay_open(st, t))
+    goto error;
+  svcts_out_reset(st);
+  st->skip_to = t;
+  st->skip_pending = 1;
+  st->skip_back = t < cur;
+  st->skip_seen = 0;
+  st->skip_seen_kf = 0;
+  if (st->skip_reply)
+    streaming_msg_free(st->skip_reply);
+  st->skip_reply = ctrl;
+  if (st->rw_pkt) {
+    svcts_pkt_drop(st->rw_pkt);
+    st->rw_pkt = NULL;
+  }
+  if (st->state == SVCTS_LIVE) {
+    st->state = SVCTS_PLAY;
+    st->speed = 100;
+    st->keyframe_mode = 0;
+  }
+  st->pause_time = t;
+  st->mono_play = mclk();
+  return;
+
+error:
+  skip->type = SMT_SKIP_ERROR;
+  streaming_target_deliver2(st->output, ctrl);
+}
+
+/* **************************************************************************
+ * Thread
+ * *************************************************************************/
+
+static void *
+svcts_thread ( void *aux )
+{
+  svcts_t *st = aux;
+  streaming_message_t *ctrl;
+  int64_t wait;
+  int64_t now;
+
+  tvh_mutex_lock(&st->lock);
+  while (st->run) {
+    if (st->reset || st->sb_old)
+      svcts_replay_drop(st);
+
+    while ((ctrl = TAILQ_FIRST(&st->ctrl)) != NULL) {
+      TAILQ_REMOVE(&st->ctrl, ctrl, sm_link);
+      if (ctrl->sm_type == SMT_SPEED)
+        svcts_speed(st, ctrl);
+      else
+        svcts_skip(st, ctrl);
+      if (st->reset)
+        svcts_replay_drop(st);
+    }
+
+    wait = sec2mono(1);
+    if (st->state == SVCTS_PLAY)
+      wait = svcts_play(st);
+    else if (st->state == SVCTS_PAUSE && st->skip_reply)
+      svcts_pause_skip(st);
+
+    now = mclk();
+    if (now >= st->mono_status + sec2mono(1)) {
+      svcts_status(st);
+      st->mono_status = now;
+    }
+    if (wait > 0 && TAILQ_EMPTY(&st->ctrl) && !st->reset && !st->sb_old)
+      tvh_cond_timedwait(&st->cond, &st->lock, mclk() + wait);
+  }
+  svcts_replay_drop(st);
+  tvh_mutex_unlock(&st->lock);
+  return NULL;
+}
+
+/* **************************************************************************
+ * Life cycle
+ * *************************************************************************/
+
+streaming_target_t *
+svcts_create ( streaming_target_t *out )
+{
+  svcts_t *st = calloc(1, sizeof(*st));
+
+  st->output   = out;
+  st->state    = SVCTS_LIVE;
+  st->speed    = 100;
+  st->run      = 1;
+  st->expect   = PTS_UNSET;
+  st->live_last_dts = PTS_UNSET;
+  st->live_last_video_dts = PTS_UNSET;
+  st->replay_last_dts = PTS_UNSET;
+  tvh_mutex_init(&st->lock, NULL);
+  tvh_cond_init(&st->cond, 1);
+  TAILQ_INIT(&st->ctrl);
+  TAILQ_INIT(&st->q);
+  svcts_out_reset(st);
+  streaming_target_init(&st->input, &svcts_input_ops, st, 0);
+  streaming_target_init(&st->sink, &svcts_sink_ops, st, 0);
+  tvh_thread_create(&st->thread, NULL, svcts_thread, st, "svcts");
+  return &st->input;
+}
+
+void
+svcts_destroy ( streaming_target_t *pad )
+{
+  svcts_t *st = (svcts_t *)pad;
+  streaming_message_t *sm;
+
+
+  tvh_mutex_lock(&st->lock);
+  st->run = 0;
+  tvh_cond_signal(&st->cond, 0);
+  tvh_mutex_unlock(&st->lock);
+  pthread_join(st->thread, NULL);
+
+  while ((sm = TAILQ_FIRST(&st->ctrl)) != NULL) {
+    TAILQ_REMOVE(&st->ctrl, sm, sm_link);
+    streaming_msg_free(sm);
+  }
+  if (st->sb)
+    svcbuf_release(st->sb);
+  if (st->live_start)
+    streaming_start_unref(st->live_start);
+  if (st->out_start)
+    streaming_start_unref(st->out_start);
+  if (st->rd_start)
+    streaming_start_unref(st->rd_start);
+  tvh_cond_destroy(&st->cond);
+  tvh_mutex_destroy(&st->lock);
+  free(st);
+}
+
+void
+svcts_attach ( streaming_target_t *pad, service_t *t )
+{
+  svcts_t *st = (svcts_t *)pad;
+  svcbuf_t *sb = svcbuf_acquire(t);
+
+  tvh_mutex_lock(&st->lock);
+  if (st->sb) {
+    if (st->sb_old)
+      svcbuf_release(st->sb_old);   /* not the thread's: it only has sb_old */
+    st->sb_old = st->sb;
+  }
+  st->sb = sb;
+  svcts_live_reset(st);
+  st->reset = 1;
+  tvh_cond_signal(&st->cond, 0);
+  tvh_mutex_unlock(&st->lock);
+}
+
+int
+svcts_behind ( streaming_target_t *pad, int64_t *behind )
+{
+  svcts_t *st = (svcts_t *)pad;
+  int64_t cur;
+  int r;
+
+  tvh_mutex_lock(&st->lock);
+  r = st->sb != NULL;
+  cur = st->state == SVCTS_LIVE ? st->live_time : st->last_time;
+  *behind = MAX(0, st->live_time - cur) / 1000000;
+  tvh_mutex_unlock(&st->lock);
+  return r;
+}
+
+int
+svcts_paused ( streaming_target_t *pad )
+{
+  svcts_t *st = (svcts_t *)pad;
+  int r;
+
+  tvh_mutex_lock(&st->lock);
+  r = st->state == SVCTS_PAUSE;
+  tvh_mutex_unlock(&st->lock);
+  return r;
+}
+
+void
+svcts_detach ( streaming_target_t *pad )
+{
+  svcts_t *st = (svcts_t *)pad;
+
+  tvh_mutex_lock(&st->lock);
+  if (st->sb) {
+    if (st->sb_old)
+      svcbuf_release(st->sb_old);
+    st->sb_old = st->sb;
+    st->sb = NULL;
+  }
+  svcts_live_reset(st);
+  st->reset = 1;
+  tvh_cond_signal(&st->cond, 0);
+  tvh_mutex_unlock(&st->lock);
+}
