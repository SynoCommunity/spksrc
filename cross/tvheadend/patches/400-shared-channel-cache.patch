+static int
+subscription_cache_keepalive_has_real
+  ( service_t *t, th_subscription_t *keep )
+{
+  th_subscription_t *s;
+
+  LIST_FOREACH(s, &t->s_subscriptions, ths_service_link)
+    if (s != keep && !s->ths_cache_keepalive)
+      return 1;
+
+  return 0;
