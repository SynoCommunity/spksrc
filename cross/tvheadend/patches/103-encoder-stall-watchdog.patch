+++ src/transcoding/transcode/module.c
@@ -51,6 +51,7 @@ transcode_init()
 {
     tvh_context_types_register();
     tvh_context_helpers_register();
+    tvh_context_watchdog_start();
 #if ENABLE_HWACCELS
     hwaccels_init();
 #endif
@@ -62,6 +63,7 @@ transcode_done()
 #if ENABLE_HWACCELS
     hwaccels_done();
 #endif
