+                                   &bsf->par_out->nb_coded_side_data,
+                                   AV_PKT_DATA_DOVI_CONF);
+    }
     return ff_cbs_bsf_generic_init(bsf, &h265_metadata_type);
 }
 
@@ -574,6 +628,13 @@ static const AVOption h265_metadata_opti
     { LEVEL("8.5", 255) },
