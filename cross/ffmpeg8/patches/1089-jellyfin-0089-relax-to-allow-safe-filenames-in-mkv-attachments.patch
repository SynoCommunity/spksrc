+static int valid_utf8_filename(const char *s)
+{
+    const uint8_t *p   = (const uint8_t *)s;
+    const uint8_t *end = p + strlen(s);
+
+    while (p < end) {
+        int32_t code;
+
+        if (av_utf8_decode(&code, &p, end,
+                           AV_UTF8_FLAG_ACCEPT_NON_CHARACTERS) < 0)
+            return 0;
+    }
+    return 1;
+}
