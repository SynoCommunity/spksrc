# CMake 3.31's FindLua cannot parse the Lua 5.5 version macros.
--- /dev/null
+++ cmake/FindLua.cmake
@@ -0,0 +1,29 @@
+# Find Lua 5.4 and 5.5 headers and libraries.
+find_path(LUA_INCLUDE_DIR lua.h HINTS ENV LUA_DIR PATH_SUFFIXES include)
+find_library(LUA_LIBRARY NAMES lua5.5 lua5.4 lua HINTS ENV LUA_DIR PATH_SUFFIXES lib)
+
+if(LUA_INCLUDE_DIR AND LUA_LIBRARY)
+  file(STRINGS "${LUA_INCLUDE_DIR}/lua.h" LUA_VERSION_MAJOR_LINE
+       REGEX "^#define[ \t]+LUA_VERSION_MAJOR_N[ \t]+[0-9]+")
+  if(LUA_VERSION_MAJOR_LINE)
+    string(REGEX REPLACE ".*[ \t]([0-9]+).*" "\\1" LUA_VERSION_MAJOR "${LUA_VERSION_MAJOR_LINE}")
+    file(STRINGS "${LUA_INCLUDE_DIR}/lua.h" LUA_VERSION_MINOR_LINE
+         REGEX "^#define[ \t]+LUA_VERSION_MINOR_N[ \t]+[0-9]+")
+    file(STRINGS "${LUA_INCLUDE_DIR}/lua.h" LUA_VERSION_PATCH_LINE
+         REGEX "^#define[ \t]+LUA_VERSION_RELEASE_N[ \t]+[0-9]+")
+    string(REGEX REPLACE ".*[ \t]([0-9]+).*" "\\1" LUA_VERSION_MINOR "${LUA_VERSION_MINOR_LINE}")
+    string(REGEX REPLACE ".*[ \t]([0-9]+).*" "\\1" LUA_VERSION_PATCH "${LUA_VERSION_PATCH_LINE}")
+  else()
+    file(STRINGS "${LUA_INCLUDE_DIR}/lua.h" LUA_RELEASE_LINE
+         REGEX "^#define[ \t]+LUA_RELEASE[ \t]+\"Lua [0-9.]+\"")
+    string(REGEX REPLACE ".*Lua ([0-9]+\\.[0-9]+\\.[0-9]+).*" "\\1" LUA_VERSION_STRING "${LUA_RELEASE_LINE}")
+    string(REGEX REPLACE "^([0-9]+)\\..*" "\\1" LUA_VERSION_MAJOR "${LUA_VERSION_STRING}")
+    string(REGEX REPLACE "^[0-9]+\\.([0-9]+)\\..*" "\\1" LUA_VERSION_MINOR "${LUA_VERSION_STRING}")
+    string(REGEX REPLACE "^[0-9]+\\.[0-9]+\\.([0-9]+).*" "\\1" LUA_VERSION_PATCH "${LUA_VERSION_STRING}")
+  endif()
+  if(NOT LUA_VERSION_STRING)
+    set(LUA_VERSION_STRING "${LUA_VERSION_MAJOR}.${LUA_VERSION_MINOR}.${LUA_VERSION_PATCH}")
+  endif()
+  set(LUA_LIBRARIES "${LUA_LIBRARY};m")
+  set(LUA_FOUND TRUE)
+endif()
