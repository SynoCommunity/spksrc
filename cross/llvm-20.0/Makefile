PKG_NAME = llvm-20.0
PKG_LLVM_MAJ = 20
PKG_VERS = $(PKG_LLVM_MAJ).1.8
PKG_EXT = tar.xz
PKG_DIST_NAME = llvm-project-$(PKG_VERS).src.$(PKG_EXT)
PKG_DIST_SITE = https://github.com/llvm/llvm-project/releases/download/llvmorg-$(PKG_VERS)
PKG_DIR = llvm-project-$(PKG_VERS).src

HOMEPAGE = https://llvm.org/
COMMENT = Minimal LLVM 20 build for llvmlite
LICENSE = Apache v2.0 with LLVM Exceptions

REQUIRED_MIN_DSM = 7.1
UNSUPPORTED_ARCHS = $(ARMv5_ARCHS) $(PPC_ARCHS) comcerto2k
REQUIRED_MIN_SRM = 1.3

# Dependencies
DEPENDS += cross/zlib
DEPENDS += cross/zstd
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_ENABLE_ZLIB=ON
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_ENABLE_ZSTD=OFF
_LLVM_SYSROOT = $(TC_WORK_DIR)/$(TC_TARGET)/$(TC_SYSROOT)
_LLVM_LDFLAGS = -L$(_LLVM_SYSROOT)/lib -L$(INSTALL_DIR)$(INSTALL_PREFIX)/lib -Wl,--rpath-link,$(INSTALL_DIR)$(INSTALL_PREFIX)/lib -Wl,--rpath,$(INSTALL_PREFIX)/lib
# Toolchain wraps staging -L in CMAKE_EXE_LINKER_FLAGS; disable to prevent
# leaking into LLVM's native sub-build. Pass sysroot via ADDITIONAL_CONFIGURE_ARGS instead.
export CMAKE_DISABLE_EXE_LINKER_FLAGS = 1
ADDITIONAL_CONFIGURE_ARGS += -DCMAKE_EXE_LINKER_FLAGS="$(_LLVM_LDFLAGS)"
ADDITIONAL_CONFIGURE_ARGS += -DCMAKE_SHARED_LINKER_FLAGS="$(_LLVM_LDFLAGS)"

# Directories
CMAKE_DIR = $(WORK_DIR)/$(PKG_DIR)/llvm

# CMake arguments
ADDITIONAL_CONFIGURE_ARGS += -DCMAKE_BUILD_TYPE=MinSizeRel
ADDITIONAL_CONFIGURE_ARGS += -DCMAKE_CROSSCOMPILING=TRUE
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_DEFAULT_TARGET_TRIPLE=$(TC_TARGET)
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_INSTALL_TOOLCHAIN_ONLY=OFF
BUILD_SHARED_LIBS = OFF
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_BUILD_LLVM_DYLIB=ON
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_LINK_LLVM_DYLIB=ON
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_ENABLE_RTTI=ON
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_ENABLE_WARNINGS=OFF
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_ENABLE_ASSERTIONS=OFF
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_BUILD_TESTS=OFF
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_BUILD_DOCS=OFF
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_INCLUDE_DOCS=OFF
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_INCLUDE_EXAMPLES=OFF
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_INCLUDE_TESTS=OFF
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_INCLUDE_BENCHMARKS=OFF
ADDITIONAL_CONFIGURE_ARGS += -Wno-dev

# Remove build warnings
ADDITIONAL_CXXFLAGS  = -Wno-parentheses
ADDITIONAL_CXXFLAGS += -Wno-dangling-reference

COMPILE_TARGET = my_llvm_compile

include ../../mk/spksrc.cross-cmake.mk

# Prevent native sub-build from finding aarch64 libraries
export CMAKE_DISABLE_EXE_LINKER_FLAGS = 1
cmake_generate_toolchain_file:
	$(MAKE) --no-print-directory DEFAULT_ENV="flags rust" $(CMAKE_TOOLCHAIN_FILE_PKG)
	@sed -i '/set(ENV{PKG_CONFIG_LIBDIR}/d' $(CMAKE_TOOLCHAIN_FILE_PKG)

.PHONY: my_llvm_compile
my_llvm_compile:
	$(RUN) cmake --build $(BUILD_DIR) -j $(NCPUS)

# ARCH specific target selection
ifeq ($(findstring $(ARCH),$(ARMv7_ARCHS)),$(ARCH))
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_TARGETS_TO_BUILD=ARM
endif

ifeq ($(findstring $(ARCH),$(ARMv8_ARCHS)),$(ARCH))
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_TARGETS_TO_BUILD=AArch64
endif

ifeq ($(findstring $(ARCH),$(i686_ARCHS) $(x64_ARCHS)),$(ARCH))
ADDITIONAL_CONFIGURE_ARGS += -DLLVM_TARGETS_TO_BUILD=X86
endif
