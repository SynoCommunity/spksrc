+++ tools/gst-launch.c
@@ -92,6 +92,9 @@
 static GstClockTime tfthen = GST_CLOCK_TIME_NONE;
 static gboolean interrupting = FALSE;
 static gboolean waiting_eos = FALSE;
+/* Synology VideoStation: start position in seconds, with or without flushing */
+static gint64 seek_start = 0;
+static gint64 seek_start_no_flush = 0;
 
 /* convenience macro so we don't have to litter the code with if(!quiet) */
 #define PRINT if(!quiet)gst_print
@@ -568,8 +571,24 @@
 #endif /* G_OS_UNIX */
 
 static void
+do_seek (GstElement * pipeline, gint64 start, GstSeekFlags flags)
+{
+  PRINT (_("Attempting to SEEK ...\n"));
+  if (!gst_element_seek (pipeline, 1.0, GST_FORMAT_TIME,
+          flags | GST_SEEK_FLAG_ACCURATE, GST_SEEK_TYPE_SET, start * GST_SECOND,
+          GST_SEEK_TYPE_NONE, GST_CLOCK_TIME_NONE))
+    gst_printerr (_("ERROR: Pipeline doesn't want to seek.\n"));
+}
+
+static void
 do_initial_play (GstElement * pipeline)
 {
+  /* a flushing seek needs the prerolled pipeline this is called on */
+  if (seek_start) {
+    do_seek (pipeline, seek_start, GST_SEEK_FLAG_FLUSH);
+    seek_start = 0;
+  }
+
   PRINT (_("Setting pipeline to PLAYING ...\n"));
 
   tfthen = gst_util_get_timestamp ();
@@ -584,6 +603,12 @@
   }
 
   target_state = GST_STATE_PLAYING;
+
+  /* a non-flushing seek waits for data to flow, so it follows PLAYING */
+  if (seek_start_no_flush) {
+    do_seek (pipeline, seek_start_no_flush, 0);
+    seek_start_no_flush = 0;
+  }
 }
 
