#!/bin/sh
PKG=dantami-repo-sync
ROOT="/var/packages/$PKG"
DATA="$ROOT/var/private"
BIN="$ROOT/target/bin/repo-sync"
PIDFILE="$DATA/service.pid"
status() {
 [ -r "$PIDFILE" ] || return 3
 pid=$(cat "$PIDFILE")
 case "$pid" in ''|*[!0-9]*) return 3;; esac
 kill -0 "$pid" 2>/dev/null || return 3
 [ "$(readlink "/proc/$pid/exe")" = "$(readlink -f "$BIN")" ] || return 3
 return 0
}
case "$1" in
 prestart)
 [ -x "$BIN" ] || exit 1
 exit 0
 ;;
 prestop) exit 0;;
 start)
 status && exit 0
 umask 077
 mkdir -p "$DATA" || exit 1
 chmod 700 "$DATA" || exit 1
 nohup "$BIN" --data "$DATA" </dev/null >>"$DATA/service.log" 2>&1 &
 count=0
 while [ "$count" -lt 10 ]; do
   status && exit 0
   sleep 1
   count=$((count+1))
 done
 if [ -n "${SYNOPKG_TEMP_LOGFILE:-}" ]; then
   printf '%s\n' '동기화 서비스가 시작되지 않았어요. 앱의 실행 진단을 확인해 주세요.' > "$SYNOPKG_TEMP_LOGFILE"
 fi
 exit 1
 ;;
 stop)
 if status; then
   kill "$pid" || exit 1
   count=0
   while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 15 ]; do sleep 1; count=$((count+1)); done
   kill -0 "$pid" 2>/dev/null && exit 1
 fi
 rm -f "$PIDFILE"
 exit 0
 ;;
 status) status; exit $?;;
 *) exit 1;;
esac
