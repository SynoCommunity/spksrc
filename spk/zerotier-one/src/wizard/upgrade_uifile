            "defaultValue": true
          }
        ]
      },
      {
        "type": "password",
        "subitems": [
          {
            "key": "zt_admin_password",
            "desc": "Your DSM password",
            "defaultValue": "",
            "validator": {
              "allowBlank": true
            }
          }
        ]
      },
      {
