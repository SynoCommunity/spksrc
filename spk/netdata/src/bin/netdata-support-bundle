#!/bin/sh
# Netdata support bundle wrapper for DSM
# Run as the package user so it can read the Agent's configuration and logs.

PKG_USER="sc-netdata"
PKG_DIR="/var/packages/netdata"
CMD="${PKG_DIR}/target/usr/sbin/netdata-support-bundle"

if [ ! -x "${CMD}" ]; then
    echo "Error: Cannot find netdata-support-bundle" >&2
    exit 1
fi

if ! sudo -n true 2>/dev/null; then
    echo "The Netdata support bundle requires administrator privileges."
    echo "Enter your DSM password when prompted."
fi

exec sudo -u "${PKG_USER}" HOME="${PKG_DIR}/var" "${CMD}" "$@"
