#!/bin/sh
PKG_NAME="netdata"
PKG_DIR="/var/packages/${PKG_NAME}"
PLUGIN_DIR="${PKG_DIR}/target/usr/libexec/netdata/plugins.d"
PLUGINS="apps.plugin systemd-journal.plugin local-listeners network-viewer.plugin ndsudo go.d.plugin"

if ! sudo -n true 2>/dev/null; then
    echo "This operation requires administrator privileges."
    echo "Enter your DSM password when prompted."
fi

for PLUGIN in ${PLUGINS}; do
    if [ -f "${PLUGIN_DIR}/${PLUGIN}" ]; then
        sudo chown root:synocommunity "${PLUGIN_DIR}/${PLUGIN}" 2>/dev/null
        # local-listeners is executed unprivileged (as nobody) by the go.d
        # service discovery discoverer, so it needs world-execute to be spawnable
        # while still gaining root through its setuid bit.
        MODE=4750
        [ "${PLUGIN}" = "local-listeners" ] && MODE=4755
        sudo chmod ${MODE} "${PLUGIN_DIR}/${PLUGIN}"
        echo "Granted root privileges to ${PLUGIN}"
    else
        echo "Warning: ${PLUGIN} not found in ${PLUGIN_DIR}" >&2
    fi
done

echo ""
# Restart netdata to apply the changes
sudo synopkg restart "${PKG_NAME}"
echo "Netdata restarted. Per-process monitoring, system log browsing, network connections and service discovery are enabled."
