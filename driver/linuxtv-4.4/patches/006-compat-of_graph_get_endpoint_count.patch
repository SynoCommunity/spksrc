--- v4l/compat.h.orig
+++ v4l/compat.h
@@ -1352,4 +1352,19 @@
 #define usb_maxpacket(udev, pipe) usb_maxpacket(udev, pipe, usb_pipeout(pipe))
 #endif
 
+/* of_graph_get_endpoint_count() is not in every 4.4 kernel */
+#ifdef NEED_OF_GRAPH_GET_ENDPOINT_COUNT
+#include <linux/of_graph.h>
+static inline int compat_of_graph_get_endpoint_count(const struct device_node *np)
+{
+	struct device_node *endpoint;
+	int num = 0;
+
+	for_each_endpoint_of_node(np, endpoint)
+		num++;
+	return num;
+}
+#define of_graph_get_endpoint_count compat_of_graph_get_endpoint_count
+#endif
+
 #endif /*  _COMPAT_H */
