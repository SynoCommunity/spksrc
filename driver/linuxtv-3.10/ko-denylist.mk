# Camera sensor whose two objects each declare an OF device table: a duplicate
# symbol in one module on these kernels, wherever CONFIG_OF is set
DENYLIST += CONFIG_VIDEO_S5C73M3

# Video codecs and blitter of STMicroelectronics SoCs, enabled on monaco
# (ARCH_STI): they need the rpmsg and DMA APIs of newer kernels
DENYLIST += CONFIG_VIDEO_STI_DELTA
DENYLIST += CONFIG_VIDEO_STI_DELTA_DRIVER
DENYLIST += CONFIG_VIDEO_STI_HVA
DENYLIST += CONFIG_VIDEO_STI_BDISP

# HDMI transmitter and receiver of embedded boards: they need the HDMI helpers
# of kernels built with CONFIG_HDMI
DENYLIST += CONFIG_VIDEO_ADV7511
DENYLIST += CONFIG_VIDEO_ADV7842

# Sensors and encoders of embedded boards: they need the OF graph and
# v4l2-fwnode, which kernels like alpine's lack
DENYLIST += CONFIG_VIDEO_ADV7343
DENYLIST += CONFIG_VIDEO_CADENCE_CSI2TX
DENYLIST += CONFIG_VIDEO_S5K5BAF
DENYLIST += CONFIG_VIDEO_TVP514X
DENYLIST += CONFIG_VIDEO_TVP7002

# The virtual test driver: it needs ktime_divns, which these kernels do not
# export
DENYLIST += CONFIG_VIDEO_VIVID
